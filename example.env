# Domínio público servido pelo Traefik (ex.: auth.exemplo.com).
# Em dev local use localhost.
DOMAIN=localhost

# Porta pública do Traefik (vazia = 80).
PORT=

# E-mail usado no certificado Let's Encrypt (apenas em produção).
ACME_EMAIL=admin@exemplo.com

# Token da API do Cloudflare com permissão Zone.DNS:Edit (usado no desafio DNS-01).
CF_DNS_API_TOKEN=

# Token do Cloudflare Tunnel (Zero Trust → Networks → Tunnels).
# Obrigatório no modo --tunnel.
CF_TUNNEL_TOKEN=

# Ambiente ACME: staging por padrão. Em produção use a URL oficial:
# https://acme-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Base da API embutida no build do frontend.
VITE_API_BASE_URL=/api/v1

# Owner da imagem no GHCR (default: ofcoliva).
# A tag é computada pelo deploy.sh (short SHA do git); o CI também publica
# uma tag imutável <sha> além de dev/main/latest.
DOCKER_IMAGE_OWNER=ofcoliva
